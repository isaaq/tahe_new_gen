# frozen_string_literal: true

# AI Prompt 插件：<%= @name %>
# 分类：<%= @category %>
# 插件ID：<%= @plugin_id %>

module Plugins
  module Other
    module AiPrompt
      class <%= @class_name %>
        # 运行：根据输入与Prompt生成输出
        # context:
        # - input: 用户输入
        # - options: Prompt配置
        def run(context = {})
          input = context[:input].to_s
          options = context[:options] || {}

          <%= @ai_logic %>
        end
      end
    end
  end
end


