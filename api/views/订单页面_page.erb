<kr:datatable source="orders" page="true" checkbox="true" fields="order_no,customer,amount,status,created_at">
  <kr:col title="订单号" field="order_no" width="180" />
  <kr:col title="客户" field="customer_id" relation="customer" relation_field="name" width="150" />
  <kr:col title="金额" field="amount" width="120" />
  <kr:col title="状态" field="status" enum="待支付,已支付,已发货,已完成,已取消" width="120" />
  <kr:col title="创建时间" field="created_at" width="160" />
  <kr:row-actions>
    <kr:action name="view" label="查看" />
    <kr:action name="edit" label="编辑" />
    <kr:action name="delete" label="删除" confirm="确认删除此订单？" />
  </kr:row-actions>
</kr:datatable>