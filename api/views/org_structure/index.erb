<%# 组织结构管理主页面 %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@5.15.3/css/all.min.css">
<style>
  /* 树形结构样式 */
  .tree-view {
    padding: 10px;
  }
  .tree-view ul {
    list-style-type: none;
    padding-left: 20px;
  }
  .tree-view li {
    margin: 5px 0;
  }
  .org-node {
    padding: 6px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .org-node:hover {
    background-color: #f0f7ff;
  }
  .org-node.active {
    background-color: #007bff;
    color: white;
  }
  
  /* 卡片样式 */
  .card {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    margin-bottom: 20px;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #f8f9fa;
  }
  .card-tools {
    display: flex;
    align-items: center;
  }
  
  /* 表格样式 */
  .table-responsive {
    margin-top: 15px;
  }
  .table th {
    background-color: #f8f9fa;
  }
  .table-actions {
    white-space: nowrap;
  }
  
  /* 表单样式 */
  .custom-file-label::after {
    content: "浏览";
  }
  
  /* 头像预览 */
  .avatar-preview {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #ddd;
  }
  
  /* 状态标签 */
  .badge-success {
    background-color: #28a745;
  }
  .badge-danger {
    background-color: #dc3545;
  }
  .badge-warning {
    background-color: #ffc107;
    color: #212529;
  }
  
  /* 部门和组织树结构 */
  .department-tree-container,
  .org-tree-container {
    max-height: 400px;
    overflow-y: auto;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 10px;
  }
  
  /* 员工列表 */
  .employee-card {
    transition: all 0.2s;
    cursor: pointer;
  }
  .employee-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  }
  .employee-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  /* 搜索框 */
  .search-box {
    margin-bottom: 15px;
  }
  
  /* 加载中状态 */
  .loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 200px;
  }
  .loading-spinner {
    width: 3rem;
    height: 3rem;
  }
</style>

<div class="container-fluid">
  <div class="row">
    <div class="col-md-3">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title">组织架构</h5>
          <div class="card-tools">
            <button type="button" class="btn btn-sm btn-primary" id="btn-add-org">
              <i class="fas fa-plus"></i> 添加组织
            </button>
          </div>
        </div>
        <div class="card-body">
          <div id="org-tree" class="tree-view"></div>
        </div>
      </div>
    </div>
    <div class="col-md-9">
      <div class="card">
        <div class="card-header">
          <ul class="nav nav-tabs card-header-tabs" id="org-tabs" role="tablist">
            <li class="nav-item">
              <a class="nav-link active" id="org-info-tab" data-toggle="tab" href="#org-info" role="tab">组织信息</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="department-tab" data-toggle="tab" href="#departments" role="tab">部门管理</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="position-tab" data-toggle="tab" href="#positions" role="tab">职位管理</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="employee-tab" data-toggle="tab" href="#employees" role="tab">员工管理</a>
            </li>
          </ul>
        </div>
        <div class="card-body">
          <div class="tab-content" id="org-tabs-content">
            <div class="tab-pane fade show active" id="org-info" role="tabpanel">
              <div id="org-detail-container">
                <div class="text-center py-5">
                  <p class="text-muted">请在左侧选择一个组织</p>
                </div>
              </div>
            </div>
            <div class="tab-pane fade" id="departments" role="tabpanel">
              <div id="department-container">
                <div class="text-center py-5">
                  <p class="text-muted">请在左侧选择一个组织</p>
                </div>
              </div>
            </div>
            <div class="tab-pane fade" id="positions" role="tabpanel">
              <div id="position-container">
                <div class="text-center py-5">
                  <p class="text-muted">请在左侧选择一个组织</p>
                </div>
              </div>
            </div>
            <div class="tab-pane fade" id="employees" role="tabpanel">
              <div id="employee-container">
                <div class="text-center py-5">
                  <p class="text-muted">请在左侧选择一个组织</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 组织表单模态框 -->
<div class="modal fade" id="org-modal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="org-modal-title">添加组织</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form id="org-form">
          <input type="hidden" id="org-id">
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="org-name">组织名称</label>
              <input type="text" class="form-control" id="org-name" name="name" required>
            </div>
            <div class="form-group col-md-6">
              <label for="org-code">组织编码</label>
              <input type="text" class="form-control" id="org-code" name="code" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="org-type">组织类型</label>
              <select class="form-control" id="org-type" name="type">
                <option value="公司">公司</option>
                <option value="子公司">子公司</option>
                <option value="分公司">分公司</option>
                <option value="部门">部门</option>
              </select>
            </div>
            <div class="form-group col-md-6">
              <label for="org-parent">上级组织</label>
              <select class="form-control" id="org-parent" name="parent_id">
                <option value="">无</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="org-description">组织描述</label>
            <textarea class="form-control" id="org-description" name="description" rows="3"></textarea>
          </div>
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="org-contact">联系人</label>
              <input type="text" class="form-control" id="org-contact" name="contact">
            </div>
            <div class="form-group col-md-6">
              <label for="org-phone">联系电话</label>
              <input type="text" class="form-control" id="org-phone" name="phone">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="org-email">联系邮箱</label>
              <input type="email" class="form-control" id="org-email" name="email">
            </div>
            <div class="form-group col-md-6">
              <label for="org-sort">排序</label>
              <input type="number" class="form-control" id="org-sort" name="sort_order" value="0">
            </div>
          </div>
          <div class="form-group">
            <label for="org-address">地址</label>
            <input type="text" class="form-control" id="org-address" name="address">
          </div>
          <div class="form-group">
            <label for="org-logo">组织Logo</label>
            <div class="custom-file">
              <input type="file" class="custom-file-input" id="org-logo" name="logo">
              <label class="custom-file-label" for="org-logo">选择文件</label>
            </div>
            <div id="org-logo-preview" class="mt-2"></div>
          </div>
          <div class="form-group">
            <div class="custom-control custom-switch">
              <input type="checkbox" class="custom-control-input" id="org-status" name="status" checked>
              <label class="custom-control-label" for="org-status">启用</label>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
        <button type="button" class="btn btn-primary" id="btn-save-org">保存</button>
      </div>
    </div>
  </div>
</div>

