<!-- 添加必要的JavaScript库 -->
<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.js"></script>

<!-- 组织结构管理的JavaScript代码 -->
<script>
$(function() {
  // 当前选中的组织ID
  let currentOrgId = null;
  
  // 初始化页面
  initPage();
  
  // 绑定事件
  bindEvents();
  
  /**
   * 初始化页面
   */
  function initPage() {
    // 加载组织树
    loadOrgTree();
  }
  
  /**
   * 绑定事件
   */
  function bindEvents() {
    // 添加组织按钮点击事件
    $('#btn-add-org').click(function() {
      showOrgModal();
    });
    
    // 保存组织按钮点击事件
    $('#btn-save-org').click(function() {
      saveOrg();
    });
    
    // 添加部门按钮点击事件
    $(document).on('click', '#btn-add-department', function() {
      showDepartmentModal();
    });
    
    // 保存部门按钮点击事件
    $('#btn-save-department').click(function() {
      saveDepartment();
    });
    
    // 添加职位按钮点击事件
    $(document).on('click', '#btn-add-position', function() {
      showPositionModal();
    });
    
    // 保存职位按钮点击事件
    $('#btn-save-position').click(function() {
      savePosition();
    });
    
    // 添加员工按钮点击事件
    $(document).on('click', '#btn-add-employee', function() {
      showEmployeeModal();
    });
    
    // 保存员工按钮点击事件
    $('#btn-save-employee').click(function() {
      saveEmployee();
    });
    
    // 切换标签页事件
    $('#org-tabs a').on('shown.bs.tab', function(e) {
      const tabId = $(e.target).attr('href');
      
      if (tabId === '#departments') {
        loadDepartments();
      } else if (tabId === '#positions') {
        loadPositions();
      } else if (tabId === '#employees') {
        loadEmployees();
      }
    });
  }
  
  /**
   * 显示组织模态框
   * @param {string} orgId 组织ID，为空则表示添加
   */
  function showOrgModal(orgId) {
    // 重置表单
    $('#org-form')[0].reset();
    $('#org-id').val('');
    
    if (orgId) {
      // 编辑模式
      $('#org-modal-title').text('编辑组织');
      
      // 加载组织数据
      $.ajax({
        url: '/api/org/' + orgId,
        type: 'GET',
        dataType: 'json',
        success: function(res) {
          if (res.status === 'success') {
            const org = res.data;
            
            $('#org-id').val(org._id);
            $('#org-name').val(org.name);
            $('#org-code').val(org.code);
            $('#org-type').val(org.type);
            $('#org-parent').val(org.parent_id || '');
            $('#org-description').val(org.description);
            $('#org-contact').val(org.contact);
            $('#org-phone').val(org.phone);
            $('#org-email').val(org.email);
            $('#org-sort').val(org.sort_order);
            $('#org-address').val(org.address);
            $('#org-status').prop('checked', org.status);
            
            if (org.logo) {
              $('#org-logo-preview').html('<img src="' + org.logo + '" class="img-thumbnail" style="max-width: 200px;">');
            }
          } else {
            toastr.error(res.message || '加载组织失败');
          }
        },
        error: function(xhr) {
          console.error('Error:', xhr.responseText);
          toastr.error('加载组织失败: ' + (xhr.responseJSON ? xhr.responseJSON.message : '未知错误'));
        }
      });
    } else {
      // 添加模式
      $('#org-modal-title').text('添加组织');
      
      // 如果有当前选中的组织，则设置为上级组织
      if (currentOrgId) {
        $('#org-parent').val(currentOrgId);
      }
    }
    
    // 加载组织列表作为上级组织选项
    loadOrgOptions();
    
    // 显示模态框
    $('#org-modal').modal('show');
  }
  
  /**
   * 加载组织树
   */
  function loadOrgTree() {
    $.ajax({
      url: '/api/org/list',
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        if (res.status === 'success') {
          renderOrgTree(res.data);
        } else {
          toastr.error(res.message || '加载组织失败');
        }
      },
      error: function() {
        toastr.error('加载组织失败');
      }
    });
  }
  
  /**
   * 渲染组织树
   * @param {Array} data 组织数据
   */
  function renderOrgTree(data) {
    const $tree = $('#org-tree');
    $tree.empty();
    
    if (data.length === 0) {
      $tree.html('<div class="text-center py-3"><p class="text-muted">暂无组织数据</p></div>');
      return;
    }
    
    const $ul = $('<ul class="tree"></ul>');
    
    data.forEach(function(org) {
      const $li = renderOrgTreeNode(org);
      $ul.append($li);
    });
    
    $tree.append($ul);
    
    // 绑定组织点击事件
    $('.org-node').click(function() {
      const orgId = $(this).data('id');
      selectOrg(orgId);
    });
  }
  
  /**
   * 渲染组织树节点
   * @param {Object} org 组织数据
   * @returns {jQuery} 节点元素
   */
  function renderOrgTreeNode(org) {
    const $li = $('<li></li>');
    const $node = $('<div class="org-node" data-id="' + org._id + '"></div>');
    $node.append('<i class="fas fa-building mr-2"></i>');
    $node.append('<span>' + org.name + '</span>');
    $li.append($node);
    
    if (org.children && org.children.length > 0) {
      const $childUl = $('<ul></ul>');
      
      org.children.forEach(function(child) {
        const $childLi = renderOrgTreeNode(child);
        $childUl.append($childLi);
      });
      
      $li.append($childUl);
    }
    
    return $li;
  }
  
  /**
   * 加载组织选项
   */
  function loadOrgOptions() {
    $.ajax({
      url: '/api/org/list',
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        if (res.status === 'success') {
          const $select = $('#org-parent');
          $select.find('option:not(:first)').remove();
          
          // 递归添加选项
          function addOptions(orgs, level) {
            orgs.forEach(function(org) {
              const prefix = '　'.repeat(level);
              $select.append('<option value="' + org._id + '">' + prefix + org.name + '</option>');
              
              if (org.children && org.children.length > 0) {
                addOptions(org.children, level + 1);
              }
            });
          }
          
          addOptions(res.data, 0);
        }
      }
    });
  }
  
  /**
   * 保存组织
   */
  function saveOrg() {
    const formData = {};
    $('#org-form').serializeArray().forEach(function(item) {
      formData[item.name] = item.value;
    });
    
    // 处理复选框
    formData.status = $('#org-status').prop('checked');
    
    const orgId = $('#org-id').val();
    const url = orgId ? '/api/org/' + orgId : '/api/org/create';
    const method = orgId ? 'PUT' : 'POST';
    
    $.ajax({
      url: url,
      type: method,
      contentType: 'application/json',
      data: JSON.stringify(formData),
      success: function(res) {
        if (res.status === 'success') {
          $('#org-modal').modal('hide');
          toastr.success('保存成功');
          loadOrgTree();
        } else {
          toastr.error(res.message || '保存失败');
        }
      },
      error: function(xhr) {
        console.error('Error:', xhr.responseText);
        toastr.error('保存失败: ' + (xhr.responseJSON ? xhr.responseJSON.message : '未知错误'));
      }
    });
  }
  
  /**
   * 选中组织
   * @param {string} orgId 组织ID
   */
  function selectOrg(orgId) {
    if (!orgId) {
      console.error('组织ID不能为空');
      toastr.error('组织ID不能为空');
      return;
    }
    
    console.log('选中组织:', orgId);
    
    // 更新当前选中的组织ID
    currentOrgId = orgId;
    
    // 更新UI选中状态
    $('.org-node').removeClass('active');
    $('.org-node[data-id="' + orgId + '"]').addClass('active');
    
    // 显示组织详情
    $.ajax({
      url: '/api/org/' + orgId,
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        if (res.status === 'success') {
          const org = res.data;
          
          // 创建组织详情HTML
          const detailHtml = `
            <div id="org-detail">
              <div class="row">
                <div class="col-md-6">
                  <h4>${org.name}</h4>
                  <p class="text-muted">${org.code || '-'}</p>
                </div>
                <div class="col-md-6 text-right">
                  <button class="btn btn-sm btn-outline-primary mr-1" onclick="showOrgModal('${org._id}')"><i class="fas fa-edit"></i> 编辑</button>
                  <button class="btn btn-sm btn-outline-danger" onclick="deleteOrg('${org._id}')"><i class="fas fa-trash"></i> 删除</button>
                </div>
              </div>
              <hr>
              <div class="row">
                <div class="col-md-6">
                  <p><strong>类型：</strong> <span>${org.type || '-'}</span></p>
                  <p><strong>描述：</strong> <span>${org.description || '-'}</span></p>
                  <p><strong>地址：</strong> <span>${org.address || '-'}</span></p>
                </div>
                <div class="col-md-6">
                  <p><strong>联系人：</strong> <span>${org.contact || '-'}</span></p>
                  <p><strong>电话：</strong> <span>${org.phone || '-'}</span></p>
                  <p><strong>邮箱：</strong> <span>${org.email || '-'}</span></p>
                  <p><strong>状态：</strong> <span class="badge ${org.status ? 'badge-success' : 'badge-danger'}">${org.status ? '正常' : '禁用'}</span></p>
                </div>
              </div>
            </div>
          `;
          
          // 更新组织详情容器
          $('#org-detail-container').html(detailHtml);
          
          // 创建部门容器HTML
          const departmentHtml = `
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5>部门列表</h5>
              <button class="btn btn-sm btn-primary" id="btn-add-department"><i class="fas fa-plus"></i> 添加部门</button>
            </div>
            <div class="table-responsive">
              <table class="table table-bordered table-hover" id="departments-table">
              </table>
            </div>
          `;
          
          // 更新部门容器
          $('#department-container').html(departmentHtml);
          
          // 创建职位容器HTML
          const positionHtml = `
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5>职位列表</h5>
              <button class="btn btn-sm btn-primary" id="btn-add-position"><i class="fas fa-plus"></i> 添加职位</button>
            </div>
            <div class="table-responsive">
              <table class="table table-bordered table-hover" id="positions-table">
              </table>
            </div>
          `;
          
          // 更新职位容器
          $('#position-container').html(positionHtml);
          
          // 创建员工容器HTML
          const employeeHtml = `
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5>员工列表</h5>
              <button class="btn btn-sm btn-primary" id="btn-add-employee"><i class="fas fa-plus"></i> 添加员工</button>
            </div>
            <div class="table-responsive">
              <table class="table table-bordered table-hover" id="employees-table">
              </table>
            </div>
          `;
          
          // 更新员工容器
          $('#employee-container').html(employeeHtml);
          
          // 加载部门数据
          loadDepartments();
          
          // 激活部门标签页
          $('#org-tabs a[href="#departments"]').tab('show');
        } else {
          toastr.error(res.message || '加载组织详情失败');
        }
      },
      error: function(xhr) {
        console.error('Error:', xhr.responseText);
        toastr.error('加载组织详情失败: ' + (xhr.responseJSON ? xhr.responseJSON.message : '未知错误'));
      }
    });
  }
  
  /**
   * 加载部门数据
   */
  function loadDepartments() {
    if (!currentOrgId) {
      return;
    }
    
    $.ajax({
      url: '/api/org/' + currentOrgId + '/departments',
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        if (res.status === 'success') {
          renderDepartments(res.data);
        } else {
          toastr.error(res.message || '加载部门失败');
        }
      },
      error: function() {
        toastr.error('加载部门失败');
      }
    });
  }
  
  /**
   * 渲染部门列表
   * @param {Array} departments 部门数据
   */
  function renderDepartments(departments) {
    const $table = $('#departments-table');
    $table.empty();
    
    if (departments.length === 0) {
      $table.html('<div class="text-center py-3"><p class="text-muted">暂无部门数据</p></div>');
      return;
    }
    
    console.log('渲染部门数据:', departments);
    
    // 创建表头
    const $thead = $('<thead class="thead-light"><tr><th>部门名称</th><th>部门编码</th><th>描述</th><th>状态</th><th>操作</th></tr></thead>');
    $table.append($thead);
    
    const $tbody = $('<tbody></tbody>');
    
    departments.forEach(function(dept) {
      const $tr = $('<tr></tr>');
      $tr.append('<td>' + dept.name + '</td>');
      $tr.append('<td>' + dept.code + '</td>');
      $tr.append('<td>' + (dept.description || '-') + '</td>');
      $tr.append('<td>' + (dept.status ? '正常' : '禁用') + '</td>');
      $tr.append('<td><button class="btn btn-sm btn-outline-primary mr-1" onclick="editDepartment(\'' + dept._id + '\')">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteDepartment(\'' + dept._id + '\')">删除</button></td>');
      
      $tbody.append($tr);
    });
    
    $table.append($tbody);
  }
  
  /**
   * 加载职位数据
   */
  function loadPositions() {
    if (!currentOrgId) {
      return;
    }
    
    $.ajax({
      url: '/api/org/' + currentOrgId + '/positions',
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        if (res.status === 'success') {
          renderPositions(res.data);
        } else {
          toastr.error(res.message || '加载职位失败');
        }
      },
      error: function() {
        toastr.error('加载职位失败');
      }
    });
  }
  
  /**
   * 渲染职位列表
   * @param {Array} positions 职位数据
   */
  function renderPositions(positions) {
    const $table = $('#positions-table');
    $table.empty();
    
    if (positions.length === 0) {
      $table.html('<div class="text-center py-3"><p class="text-muted">暂无职位数据</p></div>');
      return;
    }
    
    console.log('渲染职位数据:', positions);
    
    // 创建表头
    const $thead = $('<thead class="thead-light"><tr><th>职位名称</th><th>职位编码</th><th>描述</th><th>职级</th><th>状态</th><th>操作</th></tr></thead>');
    $table.append($thead);
    
    const $tbody = $('<tbody></tbody>');
    
    positions.forEach(function(pos) {
      const $tr = $('<tr></tr>');
      $tr.append('<td>' + pos.name + '</td>');
      $tr.append('<td>' + pos.code + '</td>');
      $tr.append('<td>' + (pos.description || '-') + '</td>');
      $tr.append('<td>' + pos.level + '</td>');
      $tr.append('<td>' + (pos.status ? '正常' : '禁用') + '</td>');
      $tr.append('<td><button class="btn btn-sm btn-outline-primary mr-1" onclick="editPosition(\'' + pos._id + '\')">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deletePosition(\'' + pos._id + '\')">删除</button></td>');
      
      $tbody.append($tr);
    });
    
    $table.append($tbody);
  }
  
  /**
   * 加载员工数据
   */
  function loadEmployees() {
    if (!currentOrgId) {
      return;
    }
    
    $.ajax({
      url: '/api/org/' + currentOrgId + '/employees',
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        if (res.status === 'success') {
          renderEmployees(res.data);
        } else {
          toastr.error(res.message || '加载员工失败');
        }
      },
      error: function() {
        toastr.error('加载员工失败');
      }
    });
  }
  
  /**
   * 渲染员工列表
   * @param {Array} employees 员工数据
   */
  function renderEmployees(employees) {
    const $table = $('#employees-table');
    $table.empty();
    
    if (employees.length === 0) {
      $table.html('<div class="text-center py-3"><p class="text-muted">暂无员工数据</p></div>');
      return;
    }
    
    console.log('渲染员工数据:', employees);
    
    // 创建表头
    const $thead = $('<thead class="thead-light"><tr><th>姓名</th><th>工号</th><th>部门</th><th>职位</th><th>手机号</th><th>邮箱</th><th>状态</th><th>操作</th></tr></thead>');
    $table.append($thead);
    
    const $tbody = $('<tbody></tbody>');
    
    employees.forEach(function(emp) {
      const $tr = $('<tr></tr>');
      $tr.append('<td>' + emp.name + '</td>');
      $tr.append('<td>' + emp.employee_id + '</td>');
      $tr.append('<td>' + (emp.department_name || '-') + '</td>');
      $tr.append('<td>' + (emp.position_name || '-') + '</td>');
      $tr.append('<td>' + (emp.phone || '-') + '</td>');
      $tr.append('<td>' + (emp.email || '-') + '</td>');
      $tr.append('<td>' + emp.status + '</td>');
      $tr.append('<td><button class="btn btn-sm btn-outline-primary mr-1" onclick="editEmployee(\'' + emp._id + '\')">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteEmployee(\'' + emp._id + '\')">删除</button></td>');
      
      $tbody.append($tr);
    });
    
    $table.append($tbody);
  }
  
  // 其他功能实现...
});
</script>
